{
  "name": "kemono-download-button",
  "version": "2.2.6",
  "description": "Kemono, Coomer, and Pawchive Download Button & UI Refactor",
  "main": "src/index.ts",
  "scripts": {
    "build": "vite build && node scripts/postbuild.mjs && vite build --mode sleazyfork && node scripts/postbuild.mjs --target sleazyfork",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "verify-locales": "node scripts/verify-locales.mjs",
    "check-locales": "node scripts/verify-locales.mjs",
    "locale-template": "node scripts/locale-template.mjs",
    "dev": "vite build --watch"
  },
  "keywords": [
    "userscript",
    "kemono",
    "coomer",
    "pawchive",
    "downloader",
    "typescript"
  ],
  "author": "bropines",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "wanakana": "^5.3.1"
  }
}
